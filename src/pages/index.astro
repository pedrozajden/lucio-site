---
import { Image, getImage } from 'astro:assets';
import mobilePhoto from '../assets/dr-lucio-jaleco-mobile.jpg';
import shared from '../content/redesign.json';
import home from '../content/home.json';
import banner from '../assets/home-banner.png';
import Icon from '../components/Icon.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Duvidas from '../components/Duvidas.astro';
import { pageForArea, scheduleUrl } from '../content/condicoes';
import Agendar from '../components/fechamento/Agendar.astro';
import Rodape from '../components/fechamento/Rodape.astro';
import WhatsAppFlutuante from '../components/fechamento/WhatsAppFlutuante.astro';
import { emphasize } from '../utils/emphasis';
import '../styles/home.css';
import '../styles/home-refinements.css';
import '../styles/home-journey.css';
import '../styles/home-autoridade.css';
const areaPreviews = [
  { title: 'Depressão', text: 'Sintomas, diagnóstico e abordagens de tratamento.' },
  { title: 'Ansiedade generalizada', text: 'Preocupação excessiva e persistente e seus impactos na rotina.' },
  { title: 'TDAH', text: 'Desatenção, hiperatividade e impulsividade.' },
  { title: 'Transtorno bipolar', text: 'Episódios de mania ou hipomania e períodos de depressão.' },
  { title: 'Transtorno de personalidade borderline', text: 'Instabilidade emocional intensa, impulsividade e dificuldades nos relacionamentos.' },
  { title: 'Esquizofrenia', text: 'Alterações no pensamento, na percepção da realidade e no comportamento.' },
];
// Um símbolo por área, em traço fino: sol nascente, ondas, foco, equilíbrio, vínculos e mente.
const areaIcons = [
  '<path d="M4 22h24M8 26.5h16"/><path d="M10 22a6 6 0 0 1 12 0"/><path d="M16 12.5V8.5M10.4 14.6l-2.6-2.6M21.6 14.6l2.6-2.6"/>',
  '<path d="M4 11c2.7-2.7 5.3-2.7 8 0s5.3 2.7 8 0 5.3-2.7 8 0"/><path d="M4 16.5c2.7-2.7 5.3-2.7 8 0s5.3 2.7 8 0 5.3-2.7 8 0"/><path d="M4 22c2.7-2.7 5.3-2.7 8 0s5.3 2.7 8 0 5.3-2.7 8 0"/>',
  '<circle cx="16" cy="16" r="11"/><circle cx="16" cy="16" r="6.5"/><circle cx="16" cy="16" r="2"/>',
  '<path d="M16 6.5v19M11 25.5h10M7 10h18"/><path d="M7 10 3.5 18M7 10l3.5 8M25 10l-3.5 8M25 10l3.5 8"/><path d="M3.5 18a3.5 3.5 0 0 0 7 0ZM21.5 18a3.5 3.5 0 0 0 7 0Z"/>',
  '<circle cx="12.5" cy="16" r="7"/><circle cx="19.5" cy="16" r="7"/>',
  '<path d="M19.5 27v-4h3a2 2 0 0 0 2-2v-3.2l2-.8-2-4.2A9.5 9.5 0 1 0 9.5 21.5V27"/><circle cx="15.5" cy="13" r="2.5"/>',
];
// Foto própria para o celular, com o Dr. Lúcio centralizado.
const mobileSmall = await getImage({ src: mobilePhoto, width: 600, format: 'webp', quality: 82 });
const mobileLarge = await getImage({ src: mobilePhoto, width: 1000, format: 'webp', quality: 82 });
const credentials = shared.credentials as { icon: 'id' | 'cap' | 'building' | 'video'; label: string; value: string }[];
const differenceIcons = ['activity', 'conversation', 'science'] as const;
// Depoimentos: três mais sóbrios em destaque (sem promessa de resultado); os demais em "ver mais".
const featuredOrder = [3, 6, 8];
const featuredReviews = featuredOrder.map(index => home.reviews[index]);
const otherReviews = home.reviews.filter((_, index) => !featuredOrder.includes(index));
const markdownBold = (text: string) => emphasize(text.replace(/\*\*/g, ''), [...text.matchAll(/\*\*(.*?)\*\*/g)].map(match => match[1]));
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="O Dr. Lúcio Moreira é psiquiatra em Belo Horizonte e Nova Lima, oferecendo atendimento acolhedor. Agende sua consulta e cuide da sua saúde mental!" />
    <title>Dr. Lúcio Moreira | Psiquiatra em BH e Nova Lima</title>
    <link rel="icon" type="image/svg+xml" href="/assets/monograma.svg" />
    <link rel="preload" href="/assets/montserrat-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/gotu-regular.ttf" as="font" type="font/ttf" crossorigin />
  </head>
  <body id="inicio">
    <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
    <SiteHeader active="home" scheduleHref={scheduleUrl} />
    <main id="conteudo">
      <section class="home-hero" aria-labelledby="hero-title">
        <div class="hero-picture" data-parallax="hero"><picture><source media="(max-width: 760px)" srcset={`${mobileSmall.src} 600w, ${mobileLarge.src} 1000w`} sizes="100vw" type="image/webp" /><Image src={banner} width={1920} height={1080} widths={[768, 1280, 1920]} sizes="100vw" alt="Dr. Lúcio Moreira, de jaleco branco e camisa azul." format="webp" quality={85} loading="eager" fetchpriority="high" /></picture></div>
        <div class="home-container hero-layout"><div class="hero-copy">
          <h1 id="hero-title">Dr. Lúcio Moreira</h1>
          <p class="hero-specialty"><span>Médico psiquiatra em Belo Horizonte e Nova Lima</span>{' '}<span class="hero-specialty-mode">Atendimento presencial e online</span></p>
          <div class="hero-message"><p class="hero-motto">Cuidar da mente é um ato de coragem.</p><p>Aqui, cada paciente é ouvido, compreendido e tratado com empatia e conhecimento técnico.</p></div>
          <div class="hero-actions"><a class="home-button" href={scheduleUrl} target="_blank" rel="noopener">Agende uma consulta <Icon name="arrow" /></a><a class="hero-secondary" href="#consulta">Como funciona a consulta <span aria-hidden="true">↓</span></a></div>
        </div></div>
      </section>
      <section class="home-credentials home-container" aria-label="Registro, formação e atendimento">
        <ul>{credentials.map(item => <li><span class="credential-icon"><Icon name={item.icon} /></span><span class="credential-text"><span class="credential-label">{item.label}</span><span class="credential-value">{item.value.split(' · ').map((part, index) => <>{index > 0 && <span class="credential-sep" aria-hidden="true"> · </span>}<span class="credential-part">{part}</span></>)}</span></span></li>)}</ul>
      </section>
      <section id="consulta" class="home-consultation home-container" aria-labelledby="consultation-title">
        <div class="consultation-panel" data-reveal>
          <div class="consultation-intro"><h2 id="consultation-title">Como funciona<br /> a consulta?</h2><p>A consulta com o Dr. Lúcio <strong>geralmente dura em torno de uma hora</strong>, para conversar sobre suas queixas e compreender sua história, sua saúde e sua rotina.</p><a class="consultation-link" href="#medico">Conheça o médico <Icon name="arrow" /></a></div>
          <div class="consultation-topics">
            <div><h3>Suas queixas e sua história</h3><p>A conversa começa pelo que motivou a consulta e considera <strong>acontecimentos atuais e aspectos da sua trajetória</strong>, para compreender como essas questões se relacionam com sua vida.</p></div>
            <div><h3>Outros tratamentos e medicamentos</h3><p>Também são considerados <strong>medicamentos em uso e tratamentos com outras especialidades</strong>, como parte da avaliação do que você está vivendo.</p></div>
            <div><h3>Hábitos, sono e rotina</h3><p>A conversa inclui <strong>sono, atividade física e hábitos do dia a dia</strong>, para entender melhor o contexto de cada pessoa.</p></div>
          </div>
          <div class="consultation-practical"><span><Icon name="video" /><span>Atendimento <strong>presencial e online</strong></span></span><span><Icon name="pin" /><span>Consultório em <strong>Nova Lima · Vila da Serra</strong></span></span></div>
        </div>
      </section>
      <section id="medico" class="home-doctor home-container" aria-labelledby="doctor-title">
        <figure class="home-portrait" data-reveal><img src="/assets/dr-lucio-800.webp" srcset="/assets/dr-lucio-480.webp 480w, /assets/dr-lucio-800.webp 800w, /assets/dr-lucio-1200.webp 1200w" sizes="(max-width: 760px) 100vw, 440px" width="800" height="1077" alt="Dr. Lúcio Moreira sorrindo, sentado à mesa." loading="lazy" decoding="async" /></figure>
        <div class="home-biography" data-reveal>
          <div class="doctor-heading"><h2 id="doctor-title">Dr. Lúcio Moreira</h2><p class="doctor-specialty">Médico psiquiatra</p><p class="doctor-registration">CRM-MG: 82117 <span aria-hidden="true">|</span> RQE: 57394</p></div>
          <div class="biography-text"><p>Com <strong>mais de cinco anos de atuação</strong>, o Dr. Lúcio Moreira já atendeu centenas de pacientes em <strong>hospitais, clínicas e ambulatórios</strong>, sempre com um olhar atento às necessidades individuais.</p></div>
          <ul class="doctor-highlights" aria-label="Diferenciais">
            {home.differences.map((difference, index) => <li><span class="highlight-icon"><Icon name={differenceIcons[index]} /></span><span><span class="highlight-title">{difference.title.replace(/:$/, '')}</span><span set:html={markdownBold(difference.text)} /></span></li>)}
          </ul>
          <ul class="doctor-facts">
              <li><strong>Residência Médica em Psiquiatria</strong><span>Concluiu, em 2023, a Residência Médica em Psiquiatria pelo Instituto de Previdência dos Servidores do Estado de Minas Gerais (IPSEMG).</span></li>
              <li><strong>Atuação como residente externo</strong><span>Ampliou seus conhecimentos como residente externo no Instituto de Psiquiatria do Hospital das Clínicas da Faculdade de Medicina da Universidade de São Paulo (IPq HC-FMUSP).</span></li>
          </ul>
          <a class="home-button" href={scheduleUrl} target="_blank" rel="noopener">Agende uma consulta <Icon name="arrow" /></a>
        </div>
      </section>
      <section id="areas" class="home-areas" aria-labelledby="areas-title"><div class="home-container areas-panel" data-reveal>
        <div class="section-heading"><p class="section-kicker">Psiquiatra</p><h2 id="areas-title">Áreas de atuação</h2></div>
        <div class="areas-grid">{areaPreviews.map((area, index) => <article class:list={['area-item', `area-${index}`, { 'area-active': pageForArea(index) }]} aria-label={home.areas[index]}>
          <div class="area-copy"><span class="area-symbol" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" set:html={areaIcons[index]} /></span><h3>{area.title}</h3>
            <p class="area-description">{area.text}</p>
            {pageForArea(index) ? <a href={pageForArea(index)!.href}>{pageForArea(index)!.cta} <span class="area-arrow"><Icon name="arrow" /></span></a> : <span class="area-pending">Página em preparação</span>}
          </div>
        </article>)}</div>
      </div></section>
      <section id="depoimentos" class="home-reviews home-reviews-cards" aria-labelledby="reviews-title">
        <div class="home-container">
          <div class="section-heading" data-reveal><h2 id="reviews-title">Depoimentos</h2><p class="reviews-subtitle">Palavras gentis de pacientes</p></div>
          <ul class="review-cards" aria-label="Depoimentos em destaque">{featuredReviews.map(review => <li data-reveal><figure><blockquote><p>{review.text}</p></blockquote><figcaption>{review.author}</figcaption></figure></li>)}</ul>
          <details class="reviews-more">
            <summary><span class="reviews-more-closed">Ver mais depoimentos</span><span class="reviews-more-open">Mostrar menos</span><span class="reviews-more-toggle" aria-hidden="true"></span></summary>
            <ul class="review-cards" aria-label="Outros depoimentos">{otherReviews.map(review => <li><figure><blockquote><p>{review.text}</p></blockquote><figcaption>{review.author}</figcaption></figure></li>)}</ul>
          </details>
        </div>
      </section>
      <Duvidas />
      <Agendar />
    </main>
    <Rodape active="home" />
    <WhatsAppFlutuante />
    <script>
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const blocks = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (!reducedMotion.matches && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(entries => {
          for (const entry of entries) if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); }
        }, { threshold: 0.08 });
        blocks.forEach(block => { block.classList.add('will-reveal'); observer.observe(block); });
        reducedMotion.addEventListener('change', event => { if (event.matches) { observer.disconnect(); blocks.forEach(block => block.classList.remove('will-reveal')); } });
      }
      const layers = [...document.querySelectorAll<HTMLElement>('[data-parallax]')];
      let scheduled = false;
      function updateParallax() {
        for (const layer of layers) {
          if (reducedMotion.matches) { layer.style.transform = ''; layer.style.opacity = ''; continue; }
          const bounds = layer.parentElement!.getBoundingClientRect();
          if (bounds.bottom < 0 || bounds.top > window.innerHeight) continue;
          const hero = layer.dataset.parallax === 'hero';
          const offset = hero ? Math.max(0, -bounds.top) * 0.16 : (window.innerHeight / 2 - bounds.top - bounds.height / 2) * 0.1;
          layer.style.transform = `translate3d(0, ${Math.max(-55, Math.min(90, offset))}px, 0)`;
          if (hero) layer.style.opacity = `${1 - Math.min(0.45, Math.max(0, -bounds.top) / bounds.height * 0.45)}`;
        }
        scheduled = false;
      }
      function scheduleParallax() { if (!scheduled) { scheduled = true; requestAnimationFrame(updateParallax); } }
      window.addEventListener('scroll', scheduleParallax, { passive: true });
      window.addEventListener('resize', scheduleParallax, { passive: true });
      reducedMotion.addEventListener('change', scheduleParallax);
      updateParallax();
    </script>
  </body>
</html>
