---
import original from '../../content/originais/borderline.json';
import content from '../../content/borderline.json';
import shared from '../../content/redesign.json';
import CondicaoLayout from '../../layouts/CondicaoLayout.astro';
import Medico from '../../components/condicao/Medico.astro';
import Acompanhamento from '../../components/condicao/Acompanhamento.astro';
import ChamadaSinais from '../../components/condicao/ChamadaSinais.astro';
import Icon from '../../components/Icon.astro';
import { emphasize, listItems } from '../../utils/emphasis';

const sections: [string, string][] = [['sintomas', 'Sinais'], ['medico', 'O médico'], ['borderline', 'O que é'], ['tratamento', 'Tratamento'], ['atendimento', 'Acompanhamento'], ['contato', 'Agendar']];
---
<CondicaoLayout
  active="borderline"
  title="Avaliação psiquiátrica do transtorno de personalidade borderline | Dr. Lúcio Moreira"
  description="Avaliação psiquiátrica do Transtorno de Personalidade Borderline (TPB) com Dr. Lúcio Moreira. Atendimento presencial em Nova Lima e online. Conheça o médico, o atendimento e as abordagens de tratamento."
  breadcrumb="Transtorno de personalidade borderline"
  titleMain="Avaliação psiquiátrica"
  titleAccent="do transtorno de personalidade borderline"
  heroLead={content.heroLead}
  sections={sections}
  variant="a"
>
  <section id="sintomas" class="cond-section cond-signs" aria-labelledby="sintomas-titulo">
    <div class="cond-container cond-signs-grid">
      <div class="cond-signs-intro" data-reveal>
        <h2 id="sintomas-titulo">Como o transtorno borderline se manifesta</h2>
        <div class="cond-prose" data-original="sintomasDiagnostico.0"><Fragment set:html={original.sintomasDiagnostico[0]} /></div>
      </div>
      <div class="cond-signs-body" data-reveal>
        <div class="cond-symptom-group-title" data-original="sintomasDiagnostico.2"><Fragment set:html={original.sintomasDiagnostico[2]} /></div>
        <ul class="cond-symptoms" aria-label="Sintomas mais frequentes do transtorno de personalidade borderline" data-original="sintomasDiagnostico.3">
          {listItems(original.sintomasDiagnostico[3]).map(item => <li set:html={item} />)}
        </ul>
      </div>
    </div>
    <ChamadaSinais />
  </section>

  <Medico />

  <section id="borderline" class="cond-section cond-understand" aria-labelledby="borderline-titulo">
    <div class="cond-container cond-understand-grid">
      <div class="cond-definition" data-reveal>
        <h2 id="borderline-titulo">O que é o transtorno de personalidade borderline?</h2>
        <div class="cond-prose cond-prose-large" data-original="oQueE.0"><Fragment set:html={original.oQueE[0]} /></div>
      </div>
      <aside id="diagnostico" class="cond-diagnosis" data-reveal aria-labelledby="diagnostico-titulo">
        <div class="cond-diagnosis-heading"><span class="cond-round-icon"><Icon name="conversation" /></span><h3 id="diagnostico-titulo">O diagnóstico é clínico</h3></div>
        <div class="cond-prose" data-original="sintomasDiagnostico.5+7"><Fragment set:html={original.sintomasDiagnostico[5]} /><Fragment set:html={original.sintomasDiagnostico[7]} /></div>
      </aside>
    </div>
  </section>

  <section id="tratamento" class="cond-section cond-treatment" aria-labelledby="tratamento-titulo">
    <div class="cond-container">
      <div class="cond-section-heading" data-reveal>
        <h2 id="tratamento-titulo">Abordagens de tratamento</h2>
        <div class="cond-prose" data-original="tratamento.0"><Fragment set:html={original.tratamento[0]} /></div>
        <p class="cond-scope" data-copy="treatmentScope">{shared.treatmentScope}</p>
      </div>
      <div class="cond-treatment-grid">
        <article class="cond-treatment-card" data-reveal>
          <span class="cond-round-icon"><Icon name="medicine" /></span>
          <h3>Tratamento medicamentoso</h3>
          <div class="cond-prose" data-copy="medication">{content.medication.map(paragraph => <p>{paragraph}</p>)}</div>
        </article>
        <article class="cond-treatment-card" data-reveal>
          <span class="cond-round-icon"><Icon name="conversation" /></span>
          <h3>Tratamento psicoterápico</h3>
          <div class="cond-prose" data-copy="psychotherapy"><p set:html={emphasize(content.psychotherapy, ['Terapia Comportamental Dialética (DBT)'])} /></div>
        </article>
        <article class="cond-treatment-card" data-reveal>
          <span class="cond-round-icon"><Icon name="activity" /></span>
          <h3>Educação e suporte familiar</h3>
          <div class="cond-prose" data-original="tratamento.9"><Fragment set:html={original.tratamento[9]} /></div>
        </article>
      </div>
      <aside class="cond-treatment-note" data-reveal aria-label="Foco do tratamento">
        <Icon name="clock" />
        <div class="cond-prose" data-original="tratamento.11"><Fragment set:html={original.tratamento[11]} /></div>
      </aside>
    </div>
  </section>

  <Acompanhamento steps={content.careSteps} />
</CondicaoLayout>
