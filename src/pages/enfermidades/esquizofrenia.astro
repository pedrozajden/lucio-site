---
import original from '../../content/originais/esquizofrenia.json';
import content from '../../content/esquizofrenia.json';
import shared from '../../content/redesign.json';
import CondicaoLayout from '../../layouts/CondicaoLayout.astro';
import Medico from '../../components/condicao/Medico.astro';
import Acompanhamento from '../../components/condicao/Acompanhamento.astro';
import ChamadaSinais from '../../components/condicao/ChamadaSinais.astro';
import Icon from '../../components/Icon.astro';
import { listItems } from '../../utils/emphasis';

const sections: [string, string][] = [['sintomas', 'Sinais'], ['medico', 'O médico'], ['esquizofrenia', 'O que é'], ['tratamento', 'Tratamento'], ['atendimento', 'Acompanhamento'], ['contato', 'Agendar']];
---
<CondicaoLayout
  active="esquizofrenia"
  title="Psiquiatra para esquizofrenia em BH e Nova Lima | Dr. Lúcio Moreira"
  description="Avaliação e tratamento de esquizofrenia com o psiquiatra Dr. Lúcio Moreira, em Nova Lima (BH) e online. Sintomas, diagnóstico e acompanhamento."
  breadcrumb="Esquizofrenia"
  titleMain="Avaliação psiquiátrica"
  titleAccent="da esquizofrenia"
  heroLead={content.heroLead}
  sections={sections}
  variant="b"
>
  <section id="sintomas" class="cond-section cond-signs" aria-labelledby="sintomas-titulo">
    <div class="cond-container cond-signs-grid">
      <div class="cond-signs-intro" data-reveal>
        <h2 id="sintomas-titulo">Como a esquizofrenia se manifesta</h2>
        <div class="cond-prose" data-original="sintomasDiagnostico.0"><Fragment set:html={original.sintomasDiagnostico[0]} /></div>
      </div>
      <div class="cond-signs-body" data-reveal>
        <ul class="cond-symptoms" aria-label="Sintomas mais comuns da esquizofrenia" data-original="sintomasDiagnostico.1">
          {listItems(original.sintomasDiagnostico[1]).map(item => <li set:html={item} />)}
        </ul>
        <aside class="cond-highlight" aria-label="Impactos dos sintomas">
          <span class="cond-round-icon"><Icon name="activity" /></span>
          <div class="cond-prose" data-original="sintomasDiagnostico.3"><Fragment set:html={original.sintomasDiagnostico[3]} /></div>
        </aside>
      </div>
    </div>
    <ChamadaSinais />
  </section>

  <Medico />

  <section id="esquizofrenia" class="cond-section cond-understand" aria-labelledby="esquizofrenia-titulo">
    <div class="cond-container cond-understand-grid">
      <div class="cond-definition" data-reveal>
        <h2 id="esquizofrenia-titulo">O que é a esquizofrenia?</h2>
        <div class="cond-prose cond-prose-large" data-original="oQueE.0"><Fragment set:html={original.oQueE[0]} /></div>
      </div>
      <aside id="diagnostico" class="cond-diagnosis" data-reveal aria-labelledby="diagnostico-titulo">
        <div class="cond-diagnosis-heading"><span class="cond-round-icon"><Icon name="conversation" /></span><h3 id="diagnostico-titulo">O diagnóstico é clínico</h3></div>
        <div class="cond-prose" data-original="sintomasDiagnostico.5+6"><Fragment set:html={original.sintomasDiagnostico[5]} /><Fragment set:html={original.sintomasDiagnostico[6]} /></div>
      </aside>
    </div>
  </section>

  <section id="tratamento" class="cond-section cond-treatment" aria-labelledby="tratamento-titulo">
    <div class="cond-container">
      <div class="cond-section-heading" data-reveal>
        <h2 id="tratamento-titulo">Abordagens de tratamento</h2>
        <div class="cond-prose" data-original="tratamento.0"><Fragment set:html={original.tratamento[0]} /></div>
        <p class="cond-scope" data-copy="treatmentScope">{shared.treatmentScope}</p>
      </div>
      <div class="cond-treatment-grid">
        <article class="cond-treatment-card" data-reveal>
          <span class="cond-round-icon"><Icon name="medicine" /></span>
          <h3>Tratamento medicamentoso</h3>
          <div class="cond-prose" data-original="tratamento.3+4+5"><Fragment set:html={original.tratamento[3]} /><Fragment set:html={original.tratamento[4]} /><Fragment set:html={original.tratamento[5]} /></div>
        </article>
        <article class="cond-treatment-card" data-reveal>
          <span class="cond-round-icon"><Icon name="conversation" /></span>
          <h3>Tratamento psicoterápico</h3>
          <div class="cond-prose" data-original="tratamento.8"><Fragment set:html={original.tratamento[8]} /></div>
        </article>
        <article class="cond-treatment-card" data-reveal>
          <span class="cond-round-icon"><Icon name="activity" /></span>
          <h3>Reabilitação psicossocial</h3>
          <div class="cond-prose" data-original="tratamento.11"><Fragment set:html={original.tratamento[11]} /></div>
        </article>
      </div>
    </div>
  </section>

  <Acompanhamento steps={content.careSteps} />
</CondicaoLayout>
